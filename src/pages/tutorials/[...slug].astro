---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('tutorials', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<ArticleLayout
  title={d.title}
  lede={d.summary}
  backHref="/tutorials"
  backLabel="All tutorials"
  badge={`Part ${String(d.number).padStart(2, '0')}`}
  meta={[d.kind === 'video' ? 'Video' : 'Article', d.duration, d.published.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })]}
>
  {d.youtube && (
    <div style="position:relative;padding-bottom:56.25%;height:0;border-radius:10px;overflow:hidden;border:1px solid var(--border);margin-bottom:32px;">
      <iframe
        src={`https://www.youtube.com/embed/${d.youtube}`}
        title={d.title}
        loading="lazy"
        allowfullscreen
        style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;"
      ></iframe>
    </div>
  )}
  <Content />
</ArticleLayout>
