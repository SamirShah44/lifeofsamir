---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  lede: string;
  backHref: string;
  backLabel: string;
  meta?: (string | undefined)[];
  badge?: string;
}
const { title, lede, backHref, backLabel, meta = [], badge } = Astro.props;
const bits = meta.filter(Boolean) as string[];
---
<BaseLayout title={`${title} — Samir`} description={lede}>
  <article class="article-wrap">
    <a href={backHref} class="article-back">← {backLabel}</a>

    <div class="article-meta">
      {badge && <span class="badge">{badge}</span>}
      {bits.map((b, i) => (
        <>
          {(i > 0 || badge) && <span class="dot">/</span>}
          <span>{b}</span>
        </>
      ))}
    </div>

    <h1>{title}</h1>
    <p class="article-lede">{lede}</p>

    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
